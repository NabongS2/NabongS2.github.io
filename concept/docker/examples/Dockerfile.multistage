# 소스만 주고 빌드까지 컨테이너 안에서 하는 형태.
# 빌드 결과를 실행용 이미지로 옮겨 담아서, 최종 이미지에 JDK 와 빌드 도구를 남기지 않는다.
#
#   docker build -f Dockerfile.multistage -t myapp:1.0 .
#
# 로컬에 자바나 Gradle 이 깔려 있지 않아도 빌드된다.


# ─── 1단계: 빌드 ───────────────────────────────────────────────
# AS build 로 이름을 붙여 두고 아래에서 COPY --from=build 로 꺼내 쓴다.
FROM gradle:8-jdk17 AS build

WORKDIR /src

# 의존성 목록만 먼저 넣고 받아 둔다.
# 소스만 바뀌었을 때 이 레이어를 다시 만들지 않아 빌드가 빨라진다.
# 이 시점엔 소스가 없어 태스크가 실패할 수 있으므로 || true 로 넘긴다.
COPY build.gradle settings.gradle ./
RUN gradle dependencies --no-daemon || true

# 소스는 자주 바뀌니 맨 아래에.
COPY src ./src
RUN gradle bootJar --no-daemon


# ─── 2단계: 실행 ───────────────────────────────────────────────
# 여기서부터가 최종 이미지다. 위쪽의 Gradle, JDK, 소스, 캐시는 안 들어간다.
FROM eclipse-temurin:17-jre

ENV TZ=Asia/Seoul
ENV JAVA_OPTS=""

# root 로 돌리지 않는다. 컨테이너가 뚫렸을 때 할 수 있는 일을 줄인다.
RUN useradd --system --create-home --shell /usr/sbin/nologin app

WORKDIR /app

# 1단계에서 만들어진 jar 만 건너온다.
COPY --from=build /src/build/libs/*.jar ./app.jar
RUN chown -R app:app /app

USER app

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "exec java ${JAVA_OPTS} -jar /app/app.jar"]
