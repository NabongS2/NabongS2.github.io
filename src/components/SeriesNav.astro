---
/**
 * The other parts of the series this post belongs to, at the top of the post.
 *
 * A reader who lands on part two from a search has no way to tell there is a
 * part one; the body links back in prose, but only if the author remembered to
 * write that sentence. This is the same information as a fact about the site.
 *
 * Renders nothing on a page that isn't part of a series, which is most of them
 * — it sits in the MarkdownContent override, so every page passes through it.
 */
import { getDocsById } from '../og';
import { seriesList, seriesStrings } from '../series';

const { id, locale } = Astro.locals.starlightRoute;

const lang = locale === 'en' ? 'en' : 'ko';
const prefix = locale ? `${locale}/` : '';

// `en/blog/redis-basics` and `blog/redis-basics` are the same post to a series.
const baseId = locale ? id.slice(prefix.length) : id;

const series = seriesList.find((candidate) => candidate.posts.includes(baseId));

const docs = await getDocsById();

const parts = (series?.posts ?? []).map((postId) => {
	const entry = docs.get(postId);
	if (!entry) {
		throw new Error(`시리즈에 적힌 ${postId} 가 없다. src/series.ts 를 고칠 것.`);
	}

	return {
		id: postId,
		// The translation if there is one, the original otherwise — which is what
		// the page at that URL will show.
		title: (docs.get(`${prefix}${postId}`) ?? entry).data.title,
		href: `/${prefix}${postId}/`,
		current: postId === baseId,
		draft: entry.data.draft === true,
	};
});

/*
  A draft has no page in a production build, so linking to one would be a dead
  link — the link validator fails the build on those, which is the behaviour we
  want. In dev the drafts are there, so they're listed.
*/
const visible = import.meta.env.PROD ? parts.filter((part) => !part.draft) : parts;

// One part on its own isn't a series worth announcing.
const show = series && visible.length > 1;
---

{
	show && (
		<nav class="series" aria-label={seriesStrings[lang].label}>
			<p class="series-heading">
				<span class="series-word">{seriesStrings[lang].label}</span>
				{series.label[lang]}
			</p>
			<ol class="series-parts">
				{visible.map((part) =>
					part.current ? (
						<li class="series-part" aria-current="page">
							<span>{part.title}</span>
						</li>
					) : (
						<li class="series-part">
							<a href={part.href}>{part.title}</a>
						</li>
					),
				)}
			</ol>
		</nav>
	)
}

<style>
	.series {
		border: 1px solid var(--sl-color-gray-5);
		border-inline-start: 3px solid var(--sl-color-accent);
		border-radius: 0.5rem;
		padding: 1rem 1.25rem;
		margin-bottom: 2rem;
		background: var(--sl-color-gray-7, var(--sl-color-gray-6));
	}

	.series-heading {
		margin: 0 0 0.6rem;
		font-size: var(--sl-text-sm);
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.series-word {
		color: var(--sl-color-gray-3);
		font-weight: 400;
	}

	.series-word::after {
		content: ' · ';
	}

	.series-parts {
		margin: 0;
		padding-inline-start: 1.4rem;
		font-size: var(--sl-text-sm);
	}

	.series-part {
		margin: 0.3rem 0;
	}

	/* The part you're reading is the one line that isn't a link, so it needs to
	   read as a position rather than as a disabled link. */
	.series-part[aria-current='page'] {
		color: var(--sl-color-white);
		font-weight: 600;
	}
</style>
